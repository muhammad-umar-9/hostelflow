# HostelFlow environment.
#
# Copy to .env on the server and fill in real values there. This file is committed and
# must never contain a real secret.
#
# Generate every secret ON THE SERVER, not on a laptop and not in a chat window:
#
#   openssl rand -base64 48      # AUTH_SECRET
#   openssl rand -base64 32      # POSTGRES_PASSWORD
#   openssl rand -base64 32      # MINIO_ROOT_PASSWORD
#
# Nothing here may be renamed to NEXT_PUBLIC_*. That prefix ships the value to every
# browser that loads the app.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# The domain Caddy serves and requests a certificate for. No scheme, no trailing slash.
APP_DOMAIN=hostel.example.com

# Public origin, including the scheme. Must be https in production: session cookies are
# issued with the Secure flag and a browser will not send them back over http.
APP_URL=https://hostel.example.com

NODE_ENV=production

# Session signing key. Rotating it signs everyone out, which is the intended behaviour
# if it is ever exposed. Minimum 32 characters; the app refuses to start below that.
AUTH_SECRET=replace-with-openssl-rand-base64-48

# ---------------------------------------------------------------------------
# PostgreSQL
#
# The database container publishes no ports. It is reachable only from the app container
# over the internal compose network, which is why the host below is `postgres`.
# ---------------------------------------------------------------------------

POSTGRES_DB=hostelflow
POSTGRES_USER=hostelflow
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32

# Must match the three values above.
DATABASE_URL=postgresql://hostelflow:replace-with-openssl-rand-base64-32@postgres:5432/hostelflow?schema=public&connection_limit=10

# ---------------------------------------------------------------------------
# MinIO — private object storage
#
# Holds resident photographs, both sides of every CNIC, guardian documents, payment
# proofs, police acknowledgements, damage photographs and generated PDFs. The bucket is
# private and the container publishes no ports; files are reachable only through the
# application's authorized download route.
# ---------------------------------------------------------------------------

MINIO_ROOT_USER=hostelflow
MINIO_ROOT_PASSWORD=replace-with-openssl-rand-base64-32

# Host only, no scheme. `minio` is the service name on the internal compose network.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_PRIVATE=hostelflow-private

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# Largest accepted upload, in bytes. 8 MB comfortably fits a phone photograph of a CNIC.
MAX_UPLOAD_BYTES=8388608

# Lifetime of a signed download URL, in seconds. Keep it short; these are bearer
# credentials for a private file.
SIGNED_URL_TTL_SECONDS=120

# ---------------------------------------------------------------------------
# Backups
#
# Point this at a volume on a different disk, or a mounted remote target. A backup stored
# beside the data it protects is not a backup.
# ---------------------------------------------------------------------------

BACKUP_DESTINATION=/backups
BACKUP_RETENTION_DAYS=14

# Seconds between runs. 86400 = daily.
#
# An interval rather than a cron expression: the backup service is a plain loop, so a
# failure is visible in `docker compose logs backup` instead of disappearing into cron's
# mail handling. The first backup runs immediately on container start, so a fresh
# deployment has a restore point straight away and a misconfiguration surfaces now rather
# than at 2am tomorrow.
BACKUP_INTERVAL_SECONDS=86400

# ---------------------------------------------------------------------------
# Development only
#
# DEMO_MODE is refused when NODE_ENV=production; the application will not start with both
# set. It exists so a developer can browse the interface without a real database, and it
# must never be enabled on a live hostel.
# ---------------------------------------------------------------------------

DEMO_MODE=false

# Read only by `npm run db:seed:demo`, which writes fictional residents. Leave it unset.
#
# Note it is NOT read from this file: the seed runs under tsx, which does not load .env,
# so it must be set on the command line deliberately:
#
#   ALLOW_DEMO_SEED=true npm run db:seed:demo
#
# It is not the only guard. The demo seed also refuses any hostel that already holds
# resident records it did not create, so a restored production dump cannot be polluted
# with invented residents even if this flag is set.
# ALLOW_DEMO_SEED=true
